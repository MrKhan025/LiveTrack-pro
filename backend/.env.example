PORT=4000
NODE_ENV=production

# Database Mode: 'postgres' (recommended for production) or 'embedded' (encrypted local store for Termux/Dev)
DB_MODE=postgres
ALLOW_EMBEDDED_IN_PROD=false
DATABASE_URL=postgresql://livetrack:ChangeMe_StrongDBPass!@postgres:5432/livetrack_pro

# MANDATORY CRYPTOGRAPHIC SECRETS (Server refuses to start if missing or left at placeholder values!)
# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32_MINIMUM_64_HEX_CHARACTERS_REQUIRED
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_OPENSSL_RAND_HEX_32_MINIMUM_64_HEX_CHARACTERS_HERE
AUDIO_ENCRYPTION_KEY=GENERATE_64_CHAR_HEX_KEY_WITH_OPENSSL_RAND_HEX_32_FOR_AES_256_GCM

# Strict Comma-Separated CORS Origin Allowlist (Never use '*' in production)
CORS_ORIGIN=https://livetrack.example.com,http://localhost:3000,http://localhost:4000

# Optional Redis URL for Distributed Production Rate Limiting (falls back to single-node memory store with warning if unset)
REDIS_URL=redis://redis:6379

# Storage & Rate Limit Configuration
STORAGE_DIR=./storage/audio
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=180

# Optional Push Notification & Outbound Alert Credentials
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
TELEGRAM_BOT_TOKEN=
SMTP_WEBHOOK_RELAY_URL=
