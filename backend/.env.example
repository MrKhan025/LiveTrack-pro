PORT=4000
NODE_ENV=production
# Set DB_MODE=postgres for PostgreSQL or DB_MODE=embedded for Termux/Edge/Local SQLite-JSON store
DB_MODE=postgres
DATABASE_URL=postgresql://livetrack:ChangeMe_StrongDBPass!@postgres:5432/livetrack_pro
JWT_ACCESS_SECRET=replace_with_64_byte_hex_random_secret_for_access_tokens
JWT_REFRESH_SECRET=replace_with_64_byte_hex_random_secret_for_refresh_tokens
AUDIO_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CORS_ORIGIN=https://localhost
STORAGE_DIR=./storage/audio
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
